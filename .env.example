# Copy to .env. Never commit .env or put real keys in source files.
DATABASE_URL=sqlite:///data/municipal_audit.db

# Used only by `python -m ingestion.run --live`.
# openai has no credits on the current account; groq is the working live provider.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=

# Not used in Phase 4.
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=false
